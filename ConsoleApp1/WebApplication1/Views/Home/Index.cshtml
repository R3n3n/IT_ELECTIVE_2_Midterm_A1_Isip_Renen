@{
    ViewData["Title"] = "My Portfolio";
}

<section id="home" class="py-5">
    
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <h5 class="text-info fw-semibold">
                    @ViewData["Greet"]
                </h5>

                <h1 class="display-3 fw-bold mt-3">
                    I'm <span class="text-info">Renen Isip</span>
                </h1>

                <h3 class="text-secondary mb-4">
                    @ViewData["Aspiring"]
                </h3>

                <p class="lead">
                    @ViewData["Intro"]
                </p>

                <div class="mt-4">

                    <a href="#projects" class="btn btn-primary btn-lg me-3">
                        View Projects
                    </a>

                    <a href="#contact" class="btn btn-outline-dark btn-lg">
                        Contact Me
                    </a>

                </div>

            </div>

            <div class="col-lg-5 text-center mt-5 mt-lg-0">

                <img src="~/images/profile.png" class="img-fluid rounded-circle shadow" style="max-width:320px;" alt="Profile Picture"/>

            </div>

        </div>

    </div>

</section>

