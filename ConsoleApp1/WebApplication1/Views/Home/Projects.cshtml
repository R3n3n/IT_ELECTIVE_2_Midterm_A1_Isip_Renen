
@{
    ViewData["Title"] = "Projects";
}

<section id="projects" class="py-5">

    <div class="container">

        <h2 class="fw-bold text-center mb-5">
            Featured Projects
        </h2>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="card h-100 shadow">

                    <img src="~/images/project1.png" class="card-img-top" alt="Project 1">

                    <div class="card-body">

                        <h4 class="card-title">
                            Parking Slot Monitoring System
                        </h4>

                        <p class="card-text">
                            @ViewData["FirstDesc"]
                        </p>

                        <p>
                            <strong>Technologies:</strong><br>

                            Microsoft Access
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <button class="btn btn-primary w-100">
                            View Details
                        </button>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card h-100 shadow">

                    <img src="~/images/project2.png" class="card-img-top" alt="Project 2">

                    <div class="card-body">

                        <h4 class="card-title">
                            Concert Ticketing System
                        </h4>

                        <p class="card-text">
                            @ViewData["SecondDesc"]
                        </p>

                        <p>
                            <strong>Technologies:</strong><br>

                            Python
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <button class="btn btn-primary w-100">
                            View Details
                        </button>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card h-100 shadow">

                    <img src="~/images/project3.png" class="card-img-top" alt="Project 3">

                    <div class="card-body">

                        <h4 class="card-title">
                            Loan Calculator Program
                        </h4>

                        <p class="card-text">
                            @ViewData["ThirdDesc"]
                        </p>

                        <p>
                            <strong>Technologies:</strong><br>

                            VB.NET
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <button class="btn btn-primary w-100">
                            View Details
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

