@{
    ViewData["Title"] = "Skills";
}

<section id="skills" class="py-5">

    <div class="container">

        <h2 class="fw-bold mb-5 text-center">
            Technical Skills
        </h2>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-code-slash text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Programming
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>@ViewData["Program1"]</li>
                            <li>@ViewData["Program2"]</li>
                            <li>@ViewData["Program3"]</li>
                            <li>@ViewData["Program4"]</li>
                            <li>@ViewData["Program5"]</li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-globe text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Web Technologies
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>@ViewData["WebTech1"]</li>
                            <li>@ViewData["WebTech2"]</li>
                            <li>@ViewData["WebTech3"]</li>
                            <li>@ViewData["WebTech4"]</li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-database text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Databases
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>@ViewData["Data1"]</li>
                            <li>@ViewData["Data2"]</li>
                            <li>@ViewData["Data3"]</li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-tools text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Development Tools
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>@ViewData["DevTool1"]</li>
                            <li>@ViewData["DevTool2"]</li>
                            <li>@ViewData["DevTool3"]</li>
                            <li>@ViewData["DevTool4"]</li>
                            <li>@ViewData["DevTool5"]</li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

