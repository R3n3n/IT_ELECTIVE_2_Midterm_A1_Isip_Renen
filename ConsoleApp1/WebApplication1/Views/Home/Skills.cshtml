
@{
    ViewData["Title"] = "Skills";
}

<section id="skills" class="py-5">

    <div class="container">

        <h2 class="fw-bold mb-5 text-center">
            Technical Skills
        </h2>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-code-slash text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Programming
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>C#</li>
                            <li>Java</li>
                            <li>Python</li>
                            <li>VB.NET</li>
                            <li>C</li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-globe text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Web Technologies
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>HTML</li>
                            <li>CSS</li>
                            <li>Bootstrap</li>
                            <li>ASP.NET Core MVC</li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-database text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Databases
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>SQL Server</li>
                            <li>MySQL</li>
                            <li>phpMyAdmin</li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 col-lg-3">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center">

                        <div class="text-center mb-3">
                            <i class="bi bi-tools text-info" style="font-size:3rem;"></i>
                        </div>

                        <h4 class="card-title">
                            Development Tools
                        </h4>

                        <ul class="list-unstyled mt-3">

                            <li>Visual Studio</li>
                            <li>VS Code</li>
                            <li>PyCharm</li>
                            <li>BlueJ</li>
                            <li>GitHub</li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

